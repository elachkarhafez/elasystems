# Contact form routing. Copy to .env.local (local) or set in the Vercel project settings.
# Email (Resend: https://resend.com). Required for email delivery.
RESEND_API_KEY=
CONTACT_EMAIL=elasystemdesign@gmail.com
# Sender must be on a domain verified in Resend, e.g. "ElaSystems <hello@elasystems.com>".
CONTACT_FROM=ElaSystems Site <onboarding@resend.dev>

# Optional SMS notification to your phone (Twilio: https://twilio.com). Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PHONE_NUMBER=+13133006898
